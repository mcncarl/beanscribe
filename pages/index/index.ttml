<view class="minutes-screen {{searchOpen ? 'is-searching' : ''}}">
  <view class="library-view" tt:if="{{view === 'library'}}">
    <view class="library-header"><text class="library-title">妙记</text><button class="new-recording" bindtap="newRecording">＋ 新建录音</button></view>
    <view class="library-status">{{loading ? '正在读取录音…' : status}}</view><view class="library-error" tt:if="{{error}}">{{error}}</view>
    <scroll-view class="recording-list" scroll-y="true" tt:if="{{records.length}}"><button class="recording-card" tt:for="{{records}}" tt:key="id" data-id="{{item.id}}" bindtap="openRecording"><view class="recording-card-title">{{item.title}}</view><view class="recording-card-meta">{{item.dateText}} · {{item.durationText}} · {{item.stateText}}</view><view class="recording-card-preview">{{item.previewText}}</view><text class="source-type-label" tt:if="{{item.sourceType !== 'live_device'}}">{{item.originLabel}}</text></button></scroll-view>
    <view class="library-empty" tt:if="{{!loading && !records.length && !error}}"><view class="empty-illustration" aria-label="暂无内容">♪</view><view>还没有录音</view><button class="primary-button" bindtap="newRecording">新建录音</button></view>
    <view class="library-footnote">{{runtimeStatus}}</view>
  </view>
  <view class="detail-view" tt:else>
    <view class="toolbar" tt:if="{{!searchOpen}}"><button class="icon-button back-button" aria-label="返回录音列表" bindtap="goBack"><view class="back-icon"></view></button><view class="toolbar-spacer"></view><button class="icon-button" aria-label="生成纪要" bindtap="showAi"><view class="ai-icon"></view></button><button class="icon-button" aria-label="搜索文字" bindtap="toggleSearch"><view class="search-icon"></view></button><button class="icon-button" aria-label="导出录音内容" bindtap="openExport"><view class="share-icon"><view class="share-arrow"></view></view></button></view>
    <view class="record-header" tt:if="{{!searchOpen}}"><view class="record-title">{{title}}</view><view class="record-meta"><view class="clock-icon"></view><text>{{dateLabel}}</text></view><view class="prototype-status real-status"><view class="status-dot {{captureState === 'recording' ? 'is-playing' : ''}}"></view>{{status}}</view><view class="save-status">{{saveStatus}}</view><view class="record-origin" tt:if="{{originLabel !== '录音豆现场接收'}}">{{originLabel}}</view></view>
    <view class="capture-panel" tt:if="{{!searchOpen && captureState !== 'stopped'}}"><view class="capture-language" tt:if="{{captureState === 'draft'}}"><text>识别语言</text><button class="language-choice {{language === 'zh' ? 'selected' : ''}}" data-language="zh" bindtap="setLanguage">中文</button><button class="language-choice {{language === 'en' ? 'selected' : ''}}" data-language="en" bindtap="setLanguage">英文</button></view><view class="capture-actions"><button class="primary-button" tt:if="{{!connected && (captureState === 'draft' || captureState === 'error')}}" disabled="{{busy}}" bindtap="connectDevice">{{busy === 'connect' ? '正在连接…' : '连接录音豆'}}</button><button class="primary-button" tt:if="{{connected && captureState === 'draft'}}" disabled="{{busy}}" bindtap="startCapture">开始接收</button><button class="stop-button" tt:if="{{captureState === 'waiting' || captureState === 'recording' || captureState === 'finishing'}}" disabled="{{busy}}" bindtap="stopCapture">{{captureState === 'finishing' ? '正在收尾…' : '停止接收并保存'}}</button><button class="secondary-button" tt:if="{{(connected || sessionOpen) && captureState === 'error'}}" disabled="{{busy}}" bindtap="disconnectDevice">断开连接</button></view><view class="capture-hint">{{captureState === 'draft' ? '连接后点击开始接收，再按录音豆实体键录音。' : status}}</view></view>
    <scroll-view class="tabs-scroll" scroll-x="true" tt:if="{{!searchOpen}}"><view class="tabs"><button class="tab {{activeTab === 'transcript' ? 'selected' : ''}}" data-tab="transcript" bindtap="setTab">文字记录</button><button class="tab {{activeTab === 'summary' ? 'selected' : ''}}" data-tab="summary" bindtap="setTab">纪要</button><button class="tab {{activeTab === 'chapters' ? 'selected' : ''}}" data-tab="chapters" bindtap="setTab">章节</button><button class="tab {{activeTab === 'speakers' ? 'selected' : ''}}" data-tab="speakers" bindtap="setTab">发言人 ({{speakerCount}})</button><button class="tab {{activeTab === 'info' ? 'selected' : ''}}" data-tab="info" bindtap="setTab">录音信息</button></view></scroll-view>
    <view class="search-header" tt:if="{{searchOpen}}"><view class="search-bar"><view class="search-field"><view class="search-icon"></view><input class="search-input" placeholder="搜索" value="{{searchQuery}}" maxlength="80" bindinput="updateSearch" /><button class="clear-query" tt:if="{{searchQuery}}" bindtap="clearQuery">×</button></view><button class="text-button" bindtap="clearSearch">取消</button></view><view class="search-prototype-status" tt:if="{{originLabel !== '录音豆现场接收'}}">{{originLabel}}</view></view>
    <scroll-view class="minutes-content" scroll-y="true" scroll-into-view="{{scrollTarget}}">
      <view class="transcript-view" tt:if="{{activeTab === 'transcript'}}"><view class="transcript-empty" tt:if="{{!rows.length}}">暂无文字记录</view><view class="utterance" tt:for="{{rows}}" tt:key="id"><view class="speaker-line"><view class="speaker-avatar"><view class="person-icon"></view></view><button class="speaker-name" data-speaker="{{item.speaker}}" bindtap="editSpeaker">{{item.speaker}}</button><text class="meta-bullet">·</text><button class="segment-time" data-id="{{item.id}}" aria-label="定位到 {{item.time}}" bindtap="seekSegment">{{item.time}}</button><text class="manual-edited-label" tt:if="{{item.contentEdited}}">已编辑</text><text class="partial-label" tt:if="{{!item.final}}">识别中</text><button class="edit-text-button" data-id="{{item.id}}" bindtap="editSegment">编辑</button></view><view class="utterance-text"><text tt:for="{{item.sourceParts}}" tt:for-item="part" tt:key="key" id="{{part.id}}" class="{{part.match ? 'search-match' : ''}} {{part.active ? 'active-match' : ''}}">{{part.text}}</text></view><view class="content-conflict" tt:if="{{item.contentConflict}}">原转写已更新，请核对手工修改<view class="provider-source" tt:if="{{item.providerSource}}">原转写：{{item.providerSource}}</view></view><view class="translation-text" tt:if="{{showTranslations && item.translation}}">{{item.translation}}</view></view></view>
      <view class="content-tab" tt:elif="{{activeTab === 'summary'}}"><view class="summary-body" tt:if="{{summary}}"><view class="summary-stale" tt:if="{{summaryStale}}">文字已修改，建议重新生成纪要。</view><view class="summary-text">{{summary}}</view><button class="text-button regenerate-button" disabled="{{busy}}" bindtap="requestSummary">重新生成</button></view><view class="empty-view" tt:else><view class="empty-illustration" aria-label="暂无内容">♪</view><view class="empty-label">{{summaryStatus === 'loading' ? '正在生成纪要…' : summaryError || '尚未生成纪要'}}</view><button class="text-button empty-action" disabled="{{busy}}" bindtap="requestSummary">生成纪要</button></view></view>
      <view class="content-tab" tt:elif="{{activeTab === 'chapters'}}"><view class="chapters-body" tt:if="{{chapters.length}}"><button class="chapter-row" tt:for="{{chapters}}" tt:key="id" data-time="{{item.startMs}}" bindtap="jumpChapter"><text class="chapter-time">{{item.time}}</text><text>{{item.title}}</text><text class="chevron">›</text></button></view><view class="empty-view" tt:else><view class="empty-illustration" aria-label="暂无内容">♪</view><view class="empty-label">{{summaryStatus === 'loading' ? '正在生成章节…' : '尚未返回章节'}}</view><button class="text-button empty-action" disabled="{{busy}}" bindtap="requestSummary">生成纪要与章节</button></view></view>
      <view class="secondary-view speakers-view" tt:elif="{{activeTab === 'speakers'}}"><view class="speaker-stat" tt:for="{{speakerRows}}" tt:key="name"><button class="speaker-profile" data-speaker="{{item.name}}" bindtap="editSpeaker"><view class="speaker-avatar"><view class="person-icon"></view></view><text>{{item.name}}</text><text class="speaker-percent">{{item.percentText}}</text></button><view class="speaker-track" tt:if="{{item.percent !== null}}"><view class="speaker-fill" style="width:{{item.percent}}%;margin-left:0"></view></view></view><view class="local-data-note">{{speakerNote}}</view><view tt:if="{{capabilities.speakers}}"><view class="local-data-note">{{speakerJobMessage}}</view><view tt:for="{{speakerPreview}}" tt:key="index"><view>{{item.speaker}}</view><view>{{item.text}}</view></view><button tt:if="{{speakerJobStatus === 'idle'}}" disabled="{{busy}}" bindtap="requestSpeakers">识别发言人</button><button tt:if="{{speakerJobStatus === 'pending' || speakerJobStatus === 'running' || speakerJobStatus === 'waiting' || speakerJobStatus === 'query_error' || speakerJobStatus === 'submitting'}}" disabled="{{busy}}" bindtap="refreshSpeakers">刷新识别进度</button><button tt:if="{{speakerJobStatus === 'ready'}}" disabled="{{busy}}" bindtap="applySpeakerResult">应用识别结果并保留原稿</button></view></view>
      <view class="secondary-view info-view" tt:elif="{{activeTab === 'info'}}"><view class="info-group"><view class="info-label">来源</view><view class="info-value">{{sourceLabel}}</view><view class="local-data-note">{{originLabel}}</view></view><view class="info-group"><view class="info-label">保存状态</view><view class="info-value">{{saveStatus}}</view></view><view class="info-group"><view class="info-label">创建时间</view><view class="info-value">{{createdAt}}</view></view><view class="info-group"><view class="info-label">录音时长</view><view class="info-value">{{duration}}</view></view></view>
    </scroll-view>
    <view class="search-navigation" tt:if="{{searchOpen && searchQuery}}"><text class="search-count">{{searchCount ? searchIndex + 1 : 0}} / {{searchCount}}</text><button class="icon-button" disabled="{{!searchCount}}" bindtap="previousMatch"><view class="match-arrow up"></view></button><button class="icon-button" disabled="{{!searchCount}}" bindtap="nextMatch"><view class="match-arrow down"></view></button></view>
    <view class="player"><slider class="seek-slider" min="0" max="100" step="0.1" value="{{progress}}" disabled="{{!hasAudio}}" activeColor="#635bdf" backgroundColor="#e9e9ed" block-color="#635bdf" block-size="12" bindchange="seek" /><view class="player-time"><text>{{elapsed}}</text><text>{{duration}}</text></view><view class="player-controls"><button class="speed-control" bindtap="openSpeed">{{speed}}x</button><button class="icon-button" disabled="{{!hasAudio}}" bindtap="skipBack"><view class="skip-icon backward"><text>15</text></view></button><button class="play-control" disabled="{{!hasAudio}}" bindtap="togglePlayback"><view class="{{running ? 'pause-icon' : 'play-icon'}}"></view></button><button class="icon-button" disabled="{{!hasAudio}}" bindtap="skipForward"><view class="skip-icon forward"><text>15</text></view></button><button class="icon-button more-control" bindtap="toggleOptions">•••</button></view></view>
  </view>
  <view class="notice {{optionsOpen || speedOpen || exportOpen || translationOpen || editorOpen ? 'over-sheet' : ''}}" tt:if="{{notice}}" bindtap="dismissNotice">{{notice}}</view>
  <button class="sheet-backdrop" tt:if="{{optionsOpen || speedOpen || exportOpen || translationOpen || editorOpen || (devices.length > 1 && !connected)}}" bindtap="closeSheets"></button>
  <view class="bottom-sheet speed-sheet real-speed-sheet" tt:if="{{speedOpen}}"><view class="speed-scale"><button class="speed-choice {{item.major ? 'major' : ''}} {{speed === item.value ? 'selected' : ''}}" tt:for="{{speedOptions}}" tt:key="value" data-speed="{{item.value}}" bindtap="selectSpeed"><view class="speed-tick"></view><text class="speed-label">{{item.major || speed === item.value ? item.value + 'x' : ''}}</text></button></view><button class="silence-row" tt:if="{{hasSilenceRanges}}" bindtap="toggleSkipSilence"><text>跳过空白片段</text><view class="toggle-switch {{skipSilence ? 'on' : ''}}"><view></view></view></button></view>
  <view class="bottom-sheet more-sheet" tt:if="{{optionsOpen}}"><view class="sheet-header"><view class="record-icon"><view class="microphone-icon"></view></view><view class="sheet-record"><view class="sheet-title">{{title}}</view><view class="sheet-owner">{{saveStatus}}</view></view><button class="close-sheet" bindtap="closeSheets">×</button></view><view class="more-scroll"><view class="menu-group"><button class="menu-row" bindtap="openRename">重命名</button><button class="menu-row" data-tab="speakers" bindtap="setTab">修改说话人名称</button><button class="menu-row" bindtap="openTranslation">翻译</button><button class="menu-row" bindtap="requestSummary">生成纪要与章节</button><button class="menu-row" bindtap="openExport">导出文字或音频</button></view></view></view>
  <view class="bottom-sheet action-sheet" tt:if="{{exportOpen}}"><view class="action-sheet-header"><text>导出</text><button class="close-sheet" bindtap="closeSheets">×</button></view><button class="export-row" data-format="txt" bindtap="exportFile">文字记录 TXT</button><button class="export-row" data-format="srt" bindtap="exportFile">字幕文件 SRT</button><button class="export-row" data-format="audio" disabled="{{!hasAudio}}" bindtap="exportFile">原始音频</button></view>
  <view class="bottom-sheet action-sheet" tt:if="{{translationOpen}}"><view class="action-sheet-header"><text>翻译</text><button class="close-sheet" bindtap="closeSheets">×</button></view><view class="translation-language"><button class="{{targetLanguage === 'en' ? 'selected' : ''}}" data-language="en" bindtap="setTranslationLanguage">翻译为英文</button><button class="{{targetLanguage === 'zh' ? 'selected' : ''}}" data-language="zh" bindtap="setTranslationLanguage">翻译为中文</button></view><button class="primary-button wide-button" disabled="{{busy}}" bindtap="requestTranslation">生成翻译</button><button class="text-button translation-visibility" bindtap="toggleTranslations">{{showTranslations ? '隐藏已生成译文' : '显示已生成译文'}}</button></view>
  <view class="bottom-sheet action-sheet editor-sheet" tt:if="{{editorOpen}}"><view class="action-sheet-header"><text>{{editorTitle}}</text><button class="close-sheet" bindtap="closeSheets">×</button></view><textarea tt:if="{{editorKind !== 'timing'}}" class="editor-input {{editorKind === 'text' ? '' : 'single-line'}}" value="{{editorValue}}" maxlength="{{editorKind === 'text' ? 2000 : editorKind === 'speaker' ? 80 : 160}}" bindinput="updateEditor" /><button class="text-button edit-timing-link" tt:if="{{editorKind === 'text'}}" bindtap="editTimingFromEditor">修改段落时间</button><view class="timing-fields" tt:if="{{editorKind === 'timing'}}"><view>开始时间（秒）<input type="digit" value="{{editorStart}}" bindinput="updateTimingStart" /></view><view>结束时间（秒）<input type="digit" value="{{editorEnd}}" bindinput="updateTimingEnd" /></view></view><button class="primary-button wide-button" bindtap="saveEditor">保存修改</button></view>
  <view class="bottom-sheet action-sheet" tt:if="{{devices.length > 1 && !connected}}"><view class="action-sheet-header">选择录音豆</view><button class="device-row" tt:for="{{devices}}" tt:key="deviceId" data-device="{{item.deviceId}}" disabled="{{busy}}" bindtap="connectDevice">{{item.name || item.deviceId}}</button></view>
</view>
