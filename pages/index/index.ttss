/* Shared screenshot-based mobile Minutes layout. index.ttss is the native copy. */
*{box-sizing:border-box}html,body{height:100%;margin:0}body,page{background:#fff;color:#26272b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;-webkit-font-smoothing:antialiased}button{padding:0;margin:0;border:0;background:transparent;color:inherit;font:inherit;line-height:normal;cursor:pointer;-webkit-tap-highlight-color:transparent}button::after{border:0}button:focus-visible,input:focus-visible{outline:2px solid #3268e8;outline-offset:3px}button:disabled{opacity:.3;cursor:default}[hidden]{display:none!important}
.minutes-screen{position:relative;display:flex;flex-direction:column;height:100vh;height:100dvh;max-width:520px;margin:auto;background:#fff;overflow:hidden}.toolbar{height:52px;flex:none;display:flex;align-items:center;padding:6px 17px 0;gap:8px}.toolbar-spacer{flex:1}.icon-button{width:38px;height:38px;display:flex;align-items:center;justify-content:center;flex:none;border-radius:8px}.back-button{margin-left:-6px}.back-icon{width:12px;height:12px;border-left:2px solid #31343c;border-bottom:2px solid #31343c;transform:rotate(45deg)}
.search-icon{width:19px;height:19px;border:1.8px solid #30323a;border-radius:50%;position:relative;transform:translate(-2px,-2px);flex:none}.search-icon::after{content:"";position:absolute;width:9px;height:1.8px;background:#30323a;right:-7px;bottom:-4px;transform:rotate(48deg);border-radius:2px}.ai-icon{width:22px;height:22px;border-radius:50%;background:conic-gradient(from 35deg,#9b73f0,#f4a3c8,#f3c56a,#89a2fa,#9b73f0);position:relative;transform:rotate(-25deg)}.ai-icon::after{content:"";position:absolute;inset:5px 4px;background:white;border-radius:50%;transform:rotate(35deg)}.share-icon{width:20px;height:19px;border-left:1.7px solid #34363c;border-bottom:1.7px solid #34363c;border-right:1.7px solid #34363c;border-radius:0 0 2px 2px;position:relative;margin-top:9px;transform:scale(.9)}.share-arrow{position:absolute;width:17px;height:12px;left:6px;top:-9px;border-top:1.8px solid #34363c;border-left:1.8px solid #34363c;border-radius:12px 0 0 0;transform:rotate(-20deg)}.share-arrow::after{content:"";position:absolute;right:-1px;top:-5px;width:7px;height:7px;border-right:1.8px solid #34363c;border-top:1.8px solid #34363c;transform:rotate(45deg)}
.record-header{padding:14px 20px 0;flex:none}.record-title{font-size:22px;font-weight:650;line-height:1.4;letter-spacing:-.45px;overflow-wrap:anywhere}.record-meta{display:flex;align-items:center;gap:5px;color:#73757d;font-size:13px;margin-top:7px;line-height:20px}.clock-icon{width:10px;height:10px;border:1px solid #8a8c94;border-radius:50%;position:relative}.clock-icon::after{content:"";position:absolute;width:3px;height:3px;top:1px;left:3px;border-left:1px solid #8a8c94;border-bottom:1px solid #8a8c94}.prototype-status{display:flex;align-items:center;gap:5px;color:#92959c;font-size:10px;line-height:17px;margin-top:5px}.status-dot{width:4px;height:4px;background:#a4a7ae;border-radius:50%;flex:none}.status-dot.is-playing{background:#6070e6}.tabs-scroll{flex:none;width:100%;overflow-x:auto;margin-top:11px;border-bottom:1px solid #f0f0f3;scrollbar-width:none}.tabs-scroll::-webkit-scrollbar{display:none}.tabs{display:flex;align-items:stretch;white-space:nowrap;padding:0 20px;gap:23px;height:46px;min-width:max-content}.tab{position:relative;display:flex;align-items:center;justify-content:center;font-size:13px;color:#71747c;flex:none;border-radius:0}.tab.selected{color:#2c5fdf;font-weight:550}.tab.selected::after{content:"";height:2px;position:absolute;left:0;right:0;bottom:0;background:#2d60de;border-radius:2px 2px 0 0}
.minutes-content{flex:1;min-height:0;overflow-y:auto;width:100%;overscroll-behavior:contain}.transcript-view{padding:17px 20px 28px}.utterance{margin-bottom:24px}.speaker-line{display:flex;align-items:center;gap:8px;color:#7a7d85;font-size:12px;line-height:22px}.speaker-avatar{width:22px;height:22px;border-radius:50%;background:#eef0f5;display:flex;align-items:center;justify-content:center;flex:none;overflow:hidden}.person-icon{height:6px;width:6px;border-radius:50%;background:#9299ab;position:relative;margin-top:-6px}.person-icon::after{content:"";width:11px;height:7px;background:#9299ab;border-radius:6px 6px 1px 1px;position:absolute;top:7px;left:-2.5px}.meta-bullet{padding:0 1px}.utterance-text{font-size:16px;line-height:1.65;letter-spacing:.05px;margin:3px 0 0 30px;overflow-wrap:anywhere}.translation-text{font-size:14px;line-height:1.6;color:#7b7e87;margin:8px 0 0 30px}.partial-label{font-size:10px;color:#828dab;margin-left:auto}
.empty-view{height:100%;min-height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px 16px 0}.empty-illustration{display:block;width:90px;height:90px;object-fit:contain}.empty-label{margin-top:16px;font-size:13px;color:#999da5;line-height:1.5;text-align:center}.secondary-view{padding:20px}.speakers-view{padding-top:18px}.speaker-profile{display:flex;gap:8px;align-items:center;font-size:14px}.speaker-percent{margin-left:auto;color:#787b84;font-size:13px}.speaker-track{height:5px;background:#f4f4f6;border-radius:4px;margin-top:9px;overflow:hidden}.speaker-fill{height:100%;width:93%;background:#5682fa;border-radius:4px;margin-left:2%}.local-data-note{font-size:10px;color:#a0a3ac;line-height:18px;margin-top:6px}.info-view{padding-top:22px}.info-group{margin-bottom:27px}.info-label{font-size:14px;color:#7d8089;line-height:22px;margin-bottom:9px}.info-person{display:flex;align-items:center;gap:6px;font-size:15px;line-height:23px}.info-value{font-size:15px;line-height:24px}
.search-header{flex:none;padding:6px 20px 0}.search-bar{display:flex;align-items:center;gap:16px;height:40px}.search-field{display:flex;align-items:center;gap:10px;flex:1;min-width:0;height:29px;border-radius:6px;background:#f6f6f8;padding:0 10px}.search-field>.search-icon{width:12px;height:12px;border-width:1.4px;border-color:#a3a6ad;transform:translate(-1px,-1px)}.search-field>.search-icon::after{width:5px;height:1.4px;background:#a3a6ad;right:-4px;bottom:-2px}.search-input{min-width:0;flex:1;height:29px;font-size:15px;border:0;background:transparent;padding:0;color:#25272d;outline:none}.search-input::-webkit-search-cancel-button{display:none}.search-input::placeholder{color:#9a9da5}.clear-query{height:16px;width:16px;border-radius:50%;background:#a1a5ae;color:#f5f5f7;line-height:14px;font-size:17px;flex:none}.text-button{font-size:15px;color:#3265dc;flex:none}.search-keywords{display:flex;align-items:center;gap:7px;min-height:35px;padding-top:8px}.keyword-chip{font-size:11px;background:#f6f6f8;color:#7f828b;border-radius:5px;padding:3px 5px;line-height:15px}.search-prototype-status{font-size:9px;line-height:14px;color:#a0a3ac;margin-top:2px}.is-searching .transcript-view{padding-top:10px}.search-match{background:#ffdf58;color:#272931;border-radius:2px}.active-match{background:#ffd32c;box-shadow:0 0 0 1px #f2be2b}.search-navigation{height:41px;padding:0 17px 0 20px;display:flex;align-items:center;justify-content:flex-end;gap:0;flex:none}.search-count{font-size:11px;color:#999da6;margin-right:10px}.match-arrow{width:11px;height:11px;border-right:2.4px solid #363941;border-bottom:2.4px solid #363941;border-radius:1px}.match-arrow.up{transform:translateY(3px) rotate(225deg)}.match-arrow.down{transform:translateY(-3px) rotate(45deg)}
.player{flex:none;padding:9px 20px max(20px,env(safe-area-inset-bottom));background:#fff}.seek-slider{display:block;width:100%;height:16px;margin:0;accent-color:#635bdf}.seek-slider[type=range]{-webkit-appearance:none;appearance:none;background:transparent;cursor:pointer}.seek-slider[type=range]::-webkit-slider-runnable-track{height:2px;border-radius:2px;background:linear-gradient(to right,#635bdf var(--progress,0%),#e9e9ed var(--progress,0%))}.seek-slider[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:10px;height:10px;background:#635bdf;border:1.5px solid #fff;border-radius:50%;margin-top:-4px;box-shadow:0 0 0 1px #d9dcf5}.player-time{display:flex;justify-content:space-between;font-size:10px;color:#9b9da6;line-height:17px;margin-top:1px}.player-controls{display:flex;align-items:center;justify-content:space-between;margin-top:12px;padding:0 7px;height:46px}.speed-control{font-size:17px;min-width:35px;line-height:38px}.play-control{width:72px;height:43px;border-radius:24px;background:linear-gradient(105deg,#585bef,#8873f1);box-shadow:0 4px 12px #7266ea19;display:flex;align-items:center;justify-content:center;flex:none}.play-icon{width:0;height:0;border-top:9px solid transparent;border-bottom:9px solid transparent;border-left:13px solid #fff;margin-left:4px;border-radius:2px}.pause-icon{width:13px;height:17px;border-left:4px solid #fff;border-right:4px solid #fff;border-radius:1px}.skip-icon{position:relative;width:18px;height:18px;border:1.8px solid #373941;border-radius:50%;font-size:8px;line-height:15px;text-align:center;font-weight:650;margin-top:3px}.skip-icon::before{content:"";position:absolute;top:-4px;width:0;height:0;border-top:3px solid transparent;border-bottom:3px solid transparent}.skip-icon.backward::before{left:1px;border-right:5px solid #373941;transform:rotate(-12deg)}.skip-icon.forward::before{right:1px;border-left:5px solid #373941;transform:rotate(12deg)}.more-control{font-size:18px;letter-spacing:2px;font-weight:600;padding-bottom:9px}
.notice{position:absolute;left:20px;right:20px;bottom:132px;z-index:12;padding:12px 14px;border-radius:9px;background:#2d303eee;color:#fff;font-size:13px;line-height:1.6;box-shadow:0 3px 15px #00000015}.notice.over-sheet{bottom:auto;top:72px}.sheet-backdrop{position:absolute;inset:0;z-index:8;background:#0008;border-radius:0;width:100%;height:100%}.bottom-sheet{position:absolute;left:0;right:0;bottom:0;z-index:9;border-radius:12px 12px 0 0;overflow:hidden;background:#fff}.speed-sheet{padding:25px 18px max(20px,env(safe-area-inset-bottom))}.speed-scale{height:86px;display:flex;align-items:flex-start;justify-content:space-between;padding:10px 3px 0;border-bottom:1px solid #e6e7eb}.speed-choice{display:flex;flex-direction:column;align-items:center;width:35px;min-width:35px;font-size:14px;font-weight:600;color:#30323a;gap:12px}.speed-tick{height:11px;width:3px;border-radius:3px;background:#c4c5cb}.speed-choice.major .speed-tick,.speed-choice.selected .speed-tick{height:25px}.speed-label{height:20px;white-space:nowrap}.speed-choice:not(.major):not(.selected) .speed-label{margin-top:14px}.speed-choice.selected{color:#245eeb}.speed-choice.selected .speed-tick{background:#245eeb}.silence-row{display:flex;align-items:center;width:100%;padding-top:20px;gap:8px;font-size:15px;line-height:28px;text-align:left}.skip-silence-icon{font-size:23px;line-height:20px;color:#777b84}.toggle-switch{display:block;width:46px;height:28px;border-radius:20px;background:#a4a4aa;position:relative;flex:none;margin-left:auto}.toggle-switch> :first-child{display:block;position:absolute;top:2px;left:2px;height:24px;width:24px;background:#fff;border-radius:50%;box-shadow:0 1px 3px #0001}.toggle-switch.on{background:#2455ed}.toggle-switch.on> :first-child{left:20px}
.more-sheet{background:#f3f3f6;max-height:78%;display:flex;flex-direction:column}.sheet-header{display:flex;align-items:center;gap:11px;flex:none;padding:14px;border-bottom:1px solid #dedfe4}.record-icon{height:36px;width:36px;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:7px;flex:none}.microphone-icon{width:9px;height:15px;border:2px solid #7662ec;border-radius:7px;position:relative;margin-top:-5px}.microphone-icon::before{content:"";position:absolute;left:-5px;top:6px;width:15px;height:12px;border:1.5px solid #7662ec;border-top:0;border-radius:0 0 9px 9px}.microphone-icon::after{content:"";position:absolute;width:2px;height:6px;background:#7662ec;top:17px;left:2px}.sheet-record{flex:1;min-width:0}.sheet-title{font-size:15px;font-weight:600;line-height:22px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.sheet-owner{font-size:11px;color:#7c7f89;line-height:18px}.close-sheet{align-self:flex-start;background:#dedee3;height:22px;width:22px;line-height:20px;font-size:23px;border-radius:50%;flex:none;margin-top:-1px}.more-scroll{overflow-y:auto;min-height:0;padding:14px 14px max(14px,env(safe-area-inset-bottom));overscroll-behavior:contain}.menu-group{background:#fff;border-radius:11px;overflow:hidden}.menu-row{height:43px;display:flex;align-items:center;width:100%;padding:0 10px 0 14px;gap:13px;position:relative;text-align:left;font-size:15px}.menu-row::after{content:"";position:absolute;left:43px;right:0;bottom:0;border-bottom:1px solid #e5e6e9;border-radius:0}.menu-row:last-child::after{border:0}.menu-icon{width:17px;height:22px;display:flex;align-items:center;justify-content:center;flex:none}.menu-icon .share-icon{transform:scale(.72);margin-left:-3px;margin-top:3px}.comment-row{height:53px}.menu-copy{display:flex;flex-direction:column;gap:1px;flex:1;min-width:0}.menu-subtitle{font-size:10px;color:#9fa2ab;line-height:14px}.menu-row>.toggle-switch{margin-left:2px}.delete-option{display:block;width:100%;height:43px;flex:none;margin-top:8px;background:#fff;border-radius:11px;font-size:15px;color:#ee4b4f;text-align:center}
.headphones-icon{position:relative;width:15px;height:14px;border:2px solid #34363c;border-bottom:0;border-radius:10px 10px 0 0}.headphones-icon::before,.headphones-icon::after{content:"";position:absolute;top:6px;height:8px;width:4px;border-radius:2px;background:#34363c}.headphones-icon::before{left:-3px}.headphones-icon::after{right:-3px}.edit-icon{position:relative;width:14px;height:14px;border:1.8px solid #34363c;border-radius:1px}.edit-icon::after,.pencil-icon::after{content:"";position:absolute;width:14px;height:4px;border:1.5px solid #34363c;background:white;transform:rotate(-45deg);left:4px;top:-2px;box-shadow:0 0 0 2px white}.pencil-icon{position:relative;width:14px;height:14px;border-bottom:1.8px solid #34363c}.pencil-icon::after{left:0;top:3px}.translate-icon{width:17px;height:17px;line-height:15px;border:1.5px solid #34363c;border-radius:50%;font-size:12px;font-weight:500;text-align:center;position:relative}.translate-icon::before,.translate-icon::after{content:"";position:absolute;height:2px;width:6px;background:#34363c;top:5px}.translate-icon::before{left:-4px}.translate-icon::after{right:-4px}.comment-icon{position:relative;width:17px;height:13px;border:1.6px solid #34363c;border-radius:1px;font-size:15px;font-weight:600;line-height:5px;text-align:center}.comment-icon::after{content:"";position:absolute;height:4px;width:4px;border-right:1.5px solid #34363c;border-bottom:1.5px solid #34363c;transform:rotate(45deg);left:5px;bottom:-4px;background:#fff}.download-icon{font-size:25px;height:20px;line-height:16px;width:15px;text-align:center;border-bottom:1.6px solid #34363c}.stats-icon{height:17px;width:17px;line-height:15px;border:1.6px solid #34363c;border-radius:50%;text-align:center;font-size:12px;font-family:Georgia,serif;font-weight:600}.report-icon{position:relative;font-size:25px;line-height:24px}.report-icon> :first-child{position:absolute;font-size:12px;font-weight:600;left:9px;top:3px;line-height:18px}
@media(min-width:600px){body{background:#f2f3f5}.minutes-screen{box-shadow:0 0 0 1px #eceef1}.record-header{padding-top:19px}.minutes-content{min-height:260px}}@media(max-width:360px){.tabs{gap:19px;padding:0 16px}.record-title{font-size:20px}.record-header{padding-left:16px;padding-right:16px}.transcript-view{padding-left:16px;padding-right:16px}.utterance-text{font-size:15px}.menu-row{gap:10px}.menu-subtitle{font-size:9px}}@media(max-height:620px){.more-sheet{max-height:90%}.speed-sheet{padding-top:10px}.notice.over-sheet{top:12px}}
/* Real recording workflow; the visual shell remains shared with the native page. */
.library-view,.detail-view{height:100%;min-height:0;display:flex;flex-direction:column;overflow:hidden}.library-header{display:flex;align-items:center;justify-content:space-between;padding:25px 20px 12px;flex:none}.library-header h1{font-size:25px;line-height:1.3;margin:0;font-weight:650}.new-recording{color:#2c60e5;font-size:14px}.library-status,.library-footnote{color:#92959e;font-size:12px;line-height:19px;padding:0 20px 12px}.library-footnote{margin-top:auto;padding-top:12px;padding-bottom:max(20px,env(safe-area-inset-bottom));border-top:1px solid #f3f3f6}.recording-list{overflow-y:auto;min-height:0;flex:1;padding:0 20px}.recording-card{display:block;text-align:left;width:100%;padding:18px 0;border-bottom:1px solid #eeeff3}.recording-card-title{font-size:16px;font-weight:550;line-height:24px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.recording-card-meta{font-size:11px;line-height:18px;color:#9296a0;margin-top:5px}.recording-card-preview{font-size:13px;line-height:20px;color:#797d88;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.source-type-label{display:inline-block;font-size:10px;line-height:17px;color:#8c702b;background:#fff5db;border-radius:3px;padding:0 4px;margin-top:6px}.library-empty{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:1;min-height:260px;color:#9599a3;font-size:14px}.library-empty p{margin:12px 0 22px}.library-error{margin:8px 20px;padding:10px 12px;background:#fff1f1;color:#c24144;border-radius:7px;font-size:13px;line-height:1.6}.primary-button,.secondary-button,.stop-button{font-size:13px;line-height:20px;padding:8px 15px;border-radius:7px;background:#2d61eb;color:#fff;display:inline-flex;justify-content:center;align-items:center;gap:5px}.secondary-button{background:#f1f3f8;color:#646b7b}.stop-button{background:#ef5a5a}.save-status{font-size:9px;line-height:14px;color:#9da1aa;margin-top:1px}.real-status{color:#8d939f}.capture-panel{padding:10px 20px 0;flex:none}.capture-language{display:flex;gap:8px;align-items:center;font-size:11px;color:#8b909b;margin-bottom:8px}.language-choice{padding:3px 9px;border-radius:5px;background:#f3f4f7;color:#777e8c}.language-choice.selected{background:#edf2ff;color:#2a61df}.capture-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.capture-hint{font-size:10px;color:#9298a5;line-height:16px;margin-top:7px}.transcript-empty{padding:35px 0;color:#a2a6af;font-size:13px;text-align:center}.speaker-name{text-align:left;font-size:12px;color:#777e8a}.edit-text-button{font-size:10px;color:#8d96aa;margin-left:auto;padding:3px}.speaker-stat{margin-bottom:20px}.speaker-stat .speaker-profile{width:100%;text-align:left}.summary-body{padding:22px 21px}.summary-text{font-size:15px;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere}.summary-stale{font-size:12px;line-height:1.6;color:#a57a28;background:#fff9e8;padding:9px 11px;margin-bottom:13px;border-radius:6px}.regenerate-button{margin-top:24px;font-size:13px}.empty-action{margin-top:16px;font-size:13px}.chapters-body{padding:0 20px}.chapter-row{display:flex;align-items:center;width:100%;padding:18px 0;border-bottom:1px solid #f1f2f5;text-align:left;gap:16px;font-size:15px}.chapter-time{font-size:12px;color:#466bdb;white-space:nowrap}.chevron{margin-left:auto;color:#b2b4bc;font-size:22px}#summary-panel,#chapters-panel{height:100%}.real-speed-sheet .speed-scale{border-bottom:0}.real-speed-sheet{padding-bottom:max(28px,env(safe-area-inset-bottom))}.action-sheet{padding:20px 20px max(22px,env(safe-area-inset-bottom))}.action-sheet-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:19px;font-size:17px;font-weight:550}.export-row,.device-row{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:49px;border-bottom:1px solid #eceef2;font-size:15px;text-align:left}.export-row span{font-size:11px;color:#959ba7}.translation-language{display:flex;gap:10px;margin-bottom:17px}.translation-language button{flex:1;padding:12px 8px;border-radius:7px;background:#f3f4f7;color:#737c8e;font-size:14px}.translation-language button.selected{background:#edf2ff;color:#2d61e4}.wide-button{display:flex;width:100%;font-size:15px;padding:10px}.translation-visibility{display:block;margin:16px auto 0;font-size:12px}.editor-input{display:block;width:100%;height:180px;resize:vertical;border:1px solid #e0e4eb;border-radius:7px;padding:11px;font:inherit;font-size:15px;line-height:1.65;color:#293040;margin:0 0 18px;background:#fbfcfe}.editor-input.single-line{height:64px;resize:none}.editor-sheet{max-height:80%;overflow-y:auto}#recording-audio{display:none}.player .audio-control:disabled{opacity:.35}.library-empty .primary-button{min-width:108px}
.record-origin{font-size:10px;color:#a17d37;line-height:17px;margin-top:3px}.library-title{font-size:25px;line-height:1.3;font-weight:650}.content-tab{height:100%}.real-speed-sheet .silence-row{border-top:1px solid #e7e8ed;padding-top:19px}.real-speed-sheet .speed-scale{height:80px}
.segment-time{font-size:12px;color:#7a7d85}.manual-edited-label{font-size:9px;color:#9ca4b1}.content-conflict{margin:10px 0 0 30px;padding:9px 11px;border-radius:6px;background:#fff8e8;color:#9b7226;font-size:12px;line-height:1.6}.provider-source{margin-top:6px;color:#7f7765;font-size:12px;white-space:pre-wrap}.timing-fields{display:flex;gap:14px;margin-bottom:20px}.timing-fields>label,.timing-fields>view{display:block;flex:1;min-width:0;font-size:12px;line-height:20px;color:#7a8393}.timing-fields input{display:block;width:100%;height:40px;border:1px solid #e0e4eb;border-radius:7px;margin-top:6px;padding:8px;font:inherit;font-size:16px;color:#293040;background:#fbfcfe}
.edit-timing-link{display:block;font-size:13px;margin:-5px 0 18px;padding:2px 0}
